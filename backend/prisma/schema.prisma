generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  rollNo    String   @unique
  department String
  createdAt DateTime @default(now())
}
